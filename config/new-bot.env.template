# Copy this file to .env and fill the two Feishu credentials locally.
# Do not send App Secret in chat.

FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional but recommended for group chats, so @ detection is exact.
# Run: node scripts/print-bot-info.mjs after filling .env
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_USER_ID=
FEISHU_BOT_UNION_ID=

FEISHU_LOGGER_LEVEL=info
BOT_SESSION_FILE=bot_sessions.json

CODEX_DEFAULT_SANDBOX_MODE=workspace-write
CODEX_DEFAULT_APPROVAL_POLICY=never
CODEX_PRIVILEGED_SANDBOX_MODE=danger-full-access
CODEX_PRIVILEGED_APPROVAL_POLICY=never
FEISHU_APPROVAL_ENABLED=true
FEISHU_APPROVAL_BUTTONS_ENABLED=true
FEISHU_APPROVAL_TIMEOUT_MS=60000
CODEX_SKIP_GIT_CHECK=true
CODEX_REASONING_EFFORT=medium
CODEX_WEB_SEARCH_ENABLED=true
CODEX_RUNTIME=exec-sdk
CODEX_PATH_OVERRIDE=
CODEX_WORKING_DIRECTORY=./workspace
WEB_PORT=3000

# For an independent Claude Code bot process, use a separate env file with a
# different Feishu app and a different BOT_SESSION_FILE.
# CODEX_RUNTIME=claude-code
# Set this to your local Claude Code wrapper path or command name.
# CLAUDE_CODE_BIN=$HOME/.local/bin/claude-deepseek-v4
# CLAUDE_CODE_PERMISSION_MODE=acceptEdits
# BOT_SESSION_FILE=bot_sessions.claude.json
# WEB_PORT=3001
