# Feishu App Credentials
# Get these from Feishu Developer Console -> Credentials & Basic Info
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# (可选) 设置机器人自身 ID 以便精准判断群聊 @
# 至少提供一个即可，推荐使用 OPEN_ID
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_USER_ID=
FEISHU_BOT_UNION_ID=

# Feishu SDK Logger Level (debug, info, warn, error)
FEISHU_LOGGER_LEVEL=info

# --- Codex Configuration ---

# Default execution policy for low-risk tasks.
CODEX_DEFAULT_SANDBOX_MODE=workspace-write
CODEX_DEFAULT_APPROVAL_POLICY=never

# Privileged execution policy after Feishu approval.
CODEX_PRIVILEGED_SANDBOX_MODE=danger-full-access
CODEX_PRIVILEGED_APPROVAL_POLICY=never

# Feishu approval controls.
FEISHU_APPROVAL_ENABLED=true
FEISHU_APPROVAL_BUTTONS_ENABLED=true
FEISHU_APPROVAL_TIMEOUT_MS=60000

# Skip Git Repo Check
CODEX_SKIP_GIT_CHECK=true

# Model Reasoning Effort
# Options: "minimal", "low", "medium", "high", "xhigh"
CODEX_REASONING_EFFORT=medium

# Web Search Enabled
CODEX_WEB_SEARCH_ENABLED=true

# Optional Codex binary override.
# macOS users can set this to the signed Codex.app CLI binary if needed.
CODEX_PATH_OVERRIDE=

# Working Directory
CODEX_WORKING_DIRECTORY=./workspace

# Local web status server.
WEB_PORT=3000

# Codex config directory override. Leave empty to use the user's normal Codex config.
# CODEX_CONFIG_DIR_OVERRIDE=

# --- MCP Server Configuration ---

# GitHub Personal Access Token (for GitHub MCP)
GITHUB_PERSONAL_ACCESS_TOKEN=
