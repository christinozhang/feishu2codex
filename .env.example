# Feishu App Credentials
# Get these from Feishu Developer Console -> Credentials & Basic Info
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# (可选) 设置机器人自身 ID 以便精准判断群聊 @
# 至少提供一个即可，推荐使用 OPEN_ID
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_USER_ID=
FEISHU_BOT_UNION_ID=

# Feishu SDK Logger Level (debug, info, warn, error)
FEISHU_LOGGER_LEVEL=info

# --- Codex Configuration ---

# Runtime backend.
# exec-sdk: current stable path through @openai/codex-sdk and codex exec.
# app-server: experimental path through codex app-server; created threads are easier for Codex Desktop to index.
CODEX_RUNTIME=exec-sdk

# Claude Code settings used only when CODEX_RUNTIME=claude-code.
CLAUDE_CODE_BIN=
CLAUDE_CODE_PERMISSION_MODE=
CLAUDE_CODE_MODEL=
CLAUDE_CODE_EXTRA_ARGS=
CLAUDE_CODE_DISPLAY_NAME=

# Default execution policy for low-risk tasks.
CODEX_DEFAULT_SANDBOX_MODE=workspace-write
CODEX_DEFAULT_APPROVAL_POLICY=never

# Privileged execution policy after Feishu approval.
CODEX_PRIVILEGED_SANDBOX_MODE=danger-full-access
CODEX_PRIVILEGED_APPROVAL_POLICY=never

# Feishu approval controls.
FEISHU_APPROVAL_ENABLED=true
FEISHU_APPROVAL_BUTTONS_ENABLED=true
FEISHU_APPROVAL_TIMEOUT_MS=60000

# Skip Git Repo Check
CODEX_SKIP_GIT_CHECK=true

# Model Reasoning Effort
# Leave CODEX_MODEL empty to use the selected runtime default.
CODEX_MODEL=
# Options: "minimal", "low", "medium", "high", "xhigh"
CODEX_REASONING_EFFORT=medium

# Web Search Enabled
CODEX_WEB_SEARCH_ENABLED=true

# Resource limits for Feishu-triggered Codex work.
CODEX_MAX_ACTIVE_TASKS=1
CODEX_TASK_TIMEOUT_MS=1200000
CODEX_PROCESS_NICE=10
CODEX_CPU_TIME_SECONDS=0
CODEX_CHILD_GOMAXPROCS=2
CODEX_CHILD_GOFLAGS=-p=1
CODEX_CHILD_GOMEMLIMIT=
CODEX_APP_SERVER_IDLE_SHUTDOWN_MS=60000
CODEX_INTERRUPT_KILL_GRACE_MS=5000
CODEX_PROCESS_GROUP_KILL=true

# Optional Codex binary override.
# macOS users can set this to the signed Codex.app CLI binary if needed.
CODEX_PATH_OVERRIDE=

# Default directory for Feishu-created Codex tasks.
# Explicit paths in a Feishu message override this per task.
CODEX_WORKING_DIRECTORY=/Users/christino.zhang

# Optional directory used only for Codex Desktop sidebar grouping.
# Leave empty to use CODEX_WORKING_DIRECTORY.
CODEX_DESKTOP_LIST_DIRECTORY=

# Local web status server.
WEB_PORT=3000

# Codex config directory override. Leave empty to use the user's normal Codex config.
# CODEX_CONFIG_DIR_OVERRIDE=

# --- MCP Server Configuration ---

# GitHub Personal Access Token (for GitHub MCP)
GITHUB_PERSONAL_ACCESS_TOKEN=
